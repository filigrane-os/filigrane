{
  "name": "Conversations",
  "app": [
    {
      "label": "About Conversations",
      "exec": "fili-im ctl --pid %pid action about"
    },
    {
      "label": "Keyboard Shortcuts",
      "keys": "F1",
      "exec": "fili-im ctl --pid %pid action shortcuts"
    }
  ],
  "window": [
    {
      "label": "Window Actions…",
      "keys": "Ctrl+Shift+W",
      "exec": "fili-im ctl --pid %pid action window-actions"
    },
    {
      "label": "Show Window Buttons",
      "exec": "fili-im ctl --pid %pid action toggle-window-buttons"
    },
    {
      "label": "Show Header",
      "exec": "fili-im ctl --pid %pid action toggle-header"
    },
    {
      "label": "Show Status Bar",
      "exec": "fili-im ctl --pid %pid action toggle-footer"
    }
  ],
  "menus": [
    {
      "label": "File",
      "children": [
        {
          "label": "Go to Conversation…",
          "keys": "Ctrl+K",
          "exec": "fili-im ctl --pid %pid action new-conversation"
        },
        {
          "label": "Add Account…",
          "exec": "fili-im ctl --pid %pid action add-account"
        },
        {
          "label": "Link Account…",
          "exec": "fili-im ctl --pid %pid action pair"
        },
        {
          "sep": true
        },
        {
          "label": "Settings…",
          "exec": "xdg-open ~/.config/filigrane/fili-im.toml"
        },
        {
          "sep": true
        },
        {
          "label": "Close Tab",
          "keys": "Ctrl+W",
          "exec": "fili-im ctl --pid %pid action close-tab"
        },
        {
          "label": "Close",
          "keys": "Ctrl+Q",
          "exec": "fili-im ctl --pid %pid action close"
        }
      ]
    },
    {
      "label": "Edit",
      "children": [
        {
          "label": "Copy",
          "keys": "Ctrl+C",
          "exec": "fili-im ctl --pid %pid action copy"
        },
        {
          "label": "Select All",
          "keys": "Ctrl+A",
          "exec": "fili-im ctl --pid %pid action select-all"
        },
        {
          "sep": true
        },
        {
          "label": "Find in Conversation…",
          "keys": "Ctrl+F",
          "exec": "fili-im ctl --pid %pid action search"
        },
        {
          "label": "Search All Messages…",
          "keys": "Ctrl+Shift+F",
          "exec": "fili-im ctl --pid %pid action search-all"
        }
      ]
    },
    {
      "label": "Conversation",
      "children": [
        {
          "label": "Write a Message",
          "keys": "Ctrl+L",
          "exec": "fili-im ctl --pid %pid action focus-composer"
        },
        {
          "label": "Record a Voice Message",
          "keys": "Ctrl+Shift+R",
          "exec": "fili-im ctl --pid %pid action record-voice"
        },
        {
          "label": "Reply to Last Message",
          "exec": "fili-im ctl --pid %pid action reply"
        },
        {
          "label": "Mark as Read",
          "exec": "fili-im ctl --pid %pid action mark-read"
        },
        {
          "label": "Contact Info…",
          "exec": "fili-im ctl --pid %pid action contact-info"
        },
        {
          "sep": true
        },
        {
          "label": "Next Conversation",
          "keys": "Alt+Down",
          "exec": "fili-im ctl --pid %pid action next-conversation"
        },
        {
          "label": "Previous Conversation",
          "keys": "Alt+Up",
          "exec": "fili-im ctl --pid %pid action previous-conversation"
        },
        {
          "sep": true
        },
        {
          "label": "Next Tab",
          "keys": "Ctrl+Tab",
          "exec": "fili-im ctl --pid %pid action next-tab"
        },
        {
          "label": "Previous Tab",
          "keys": "Ctrl+Shift+Tab",
          "exec": "fili-im ctl --pid %pid action previous-tab"
        },
        {
          "sep": true
        },
        {
          "label": "Refresh",
          "keys": "F5",
          "exec": "fili-im ctl --pid %pid action refresh"
        }
      ]
    },
    {
      "label": "View",
      "children": [
        {
          "label": "All Conversations",
          "exec": "fili-im ctl --pid %pid action all"
        },
        {
          "label": "Unread",
          "keys": "Ctrl+U",
          "exec": "fili-im ctl --pid %pid action unread-box"
        },
        {
          "sep": true
        },
        {
          "label": "Debug Logs",
          "keys": "Ctrl+Shift+L",
          "exec": "fili-im ctl --pid %pid action debug"
        },
        {
          "label": "Restart Service",
          "exec": "fili-im ctl --pid %pid action restart-service"
        }
      ]
    },
    {
      "label": "Status",
      "children": [
        {
          "label": "Online",
          "exec": "fili-im ctl --pid %pid action status-available"
        },
        {
          "label": "Away",
          "exec": "fili-im ctl --pid %pid action status-away"
        },
        {
          "label": "Busy",
          "exec": "fili-im ctl --pid %pid action status-busy"
        },
        {
          "label": "Offline",
          "exec": "fili-im ctl --pid %pid action status-offline"
        }
      ]
    }
  ]
}
