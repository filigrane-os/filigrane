{
  "name": "Rob",
  "app": [
    {
      "label": "About Rob",
      "exec": "fili-shell ai about"
    },
    {
      "sep": true
    },
    {
      "label": "Settings…",
      "exec": "xdg-open ~/.config/filigrane/fili-ai.toml"
    },
    {
      "sep": true
    },
    {
      "label": "Hide Chat",
      "keys": "Esc",
      "exec": "fili-shell ai close"
    }
  ],
  "menus": [
    {
      "label": "Session",
      "children": [
        {
          "label": "New Session",
          "keys": "Ctrl+N",
          "exec": "fili-shell ai new"
        },
        {
          "label": "New Session for This Application",
          "keys": "Ctrl+Shift+N",
          "exec": "fili-shell ai new-here"
        },
        {
          "label": "Sessions…",
          "keys": "Ctrl+L",
          "exec": "fili-shell ai sessions"
        },
        {
          "label": "Rename Session…",
          "keys": "F2",
          "exec": "fili-shell ai rename"
        },
        {
          "label": "Unlink from Application",
          "exec": "fili-shell ai unlink"
        },
        {
          "label": "Archive Session",
          "exec": "fili-shell ai archive"
        },
        {
          "sep": true
        },
        {
          "label": "Stop",
          "keys": "Ctrl+.",
          "exec": "fili-shell ai stop"
        },
        {
          "label": "Allow",
          "keys": "Ctrl+Return",
          "exec": "fili-shell ai allow"
        },
        {
          "label": "Deny",
          "keys": "Ctrl+Backspace",
          "exec": "fili-shell ai deny"
        },
        {
          "sep": true
        },
        {
          "label": "Remove Context Note",
          "exec": "fili-shell ai drop-context"
        }
      ]
    },
    {
      "label": "View",
      "children": [
        {
          "label": "Float Above Windows",
          "exec": "fili-shell ai float"
        },
        {
          "label": "Dock Beside Windows",
          "exec": "fili-shell ai dock"
        },
        {
          "sep": true
        },
        {
          "label": "Narrow",
          "exec": "fili-shell ai width-narrow"
        },
        {
          "label": "Medium",
          "exec": "fili-shell ai width-medium"
        },
        {
          "label": "Wide",
          "exec": "fili-shell ai width-wide"
        }
      ]
    }
  ]
}
