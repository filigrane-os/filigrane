# kanshi: display profiles (the first profile that matches the connected displays wins).
# Profiles saved by `display-save` live in ~/.config/kanshi/profiles.d/
# (outside the repository: they contain the displays' serial numbers).
include ~/.config/kanshi/profiles.d/*.conf

# Fallback: any unknown display is enabled at its preferred resolution,
# niri places it to the right of the others. Visual setup: Mod+P (displays panel), then Mod+Ctrl+P (display-save).
profile fallback {
    output * enable
}
