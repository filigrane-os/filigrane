#!/bin/sh
# Focuses the window of app-id APPID if it exists, otherwise runs the command. Usage: focus-or-run APPID CMD [ARGS...]
app="$1"; shift
win="$(niri msg -j windows 2>/dev/null | jq -r --arg a "$app" 'map(select(.app_id == $a)) | first | .id // empty')"
[ -n "$win" ] && exec niri msg action focus-window --id "$win"
setsid -f "$@"
