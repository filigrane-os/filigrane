#!/bin/bash
# restic backup of ~ to the NAS (local network only). Started by cron-watch (once a day, catching up)
# or by hand from the bar (`watch-backup now`, through bar-backup: ignores the battery and reports failures).
# Config OUTSIDE the repository (secrets): ~/.config/restic/env, for example
# RESTIC_REPOSITORY=sftp:nas:/Volume1/backup/void     # "nas" = Host of ~/.ssh/config (dedicated key)
# RESTIC_PASSWORD_FILE=$HOME/.config/restic/password
# Automatic: not configured, NAS off or on battery = silent exit 1, cron-watch retries next round.
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
CONF="$HOME/.config/restic"
STATE="$HOME/.local/state/watch"
mkdir -p "$STATE"
manual=0; [ "$1" = now ] && manual=1

refuse() { # refuse MESSAGE: silent when automatic, notified when manual
    [ "$manual" = 1 ] && notify-send -u normal -a backup "$(t 'Backup not possible')" "$1"
    exit 1
}

[ -r "$CONF/env" ] || refuse "$(t 'not configured (~/.config/restic/env)')"
. "$CONF/env"
export RESTIC_REPOSITORY RESTIC_PASSWORD_FILE

[ "$manual" = 0 ] && grep -q Discharging /sys/class/power_supply/BAT0/status 2>/dev/null && exit 1
alias_="${RESTIC_REPOSITORY#sftp:}"; alias_="${alias_%%:*}"
read -r host port < <(ssh -G "$alias_" 2>/dev/null | awk '$1=="hostname"{h=$2} $1=="port"{p=$2} END{print h, p}')
[ -n "$host" ] && timeout 3 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null || refuse "$(t 'NAS unreachable')"
restic cat config >/dev/null 2>"$STATE/backup.err" || refuse "$(t 'restic repository missing or unreadable (restic init?)')"

# Lock held during the backup: bar-backup uses it to show "running"
exec 8>"$STATE/backup.lock"
flock -n 8 || { [ "$manual" = 1 ] && notify-send -u low -a backup "$(t 'Backup')" "$(t 'Already running')"; exit 0; }
"$HOME/.local/bin/fili-shell" bar refresh 18

if ionice -c3 nice -n19 restic backup "$HOME" --exclude-caches --exclude-file="$HOME/.config/watch/backup-excludes" $(for f in "$HOME"/.config/watch/backup-excludes.d/*; do [ -f "$f" ] && printf -- '--exclude-file=%s ' "$f"; done) \
        --tag auto >"$STATE/backup.log" 2>>"$STATE/backup.err"; then
    # Forget old snapshots: prune (heavy over SFTP) only on Sunday
    if [ "$(date +%u)" = 7 ]; then
        restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune >>"$STATE/backup.log" 2>>"$STATE/backup.err"
    fi
    echo ok >"$STATE/backup.status"; touch "$STATE/backup.stamp"
    "$HOME/.local/bin/fili-shell" bar refresh 18
    notify-send -u low -a backup "$(t 'NAS backup done')" "$(tail -n 1 "$STATE/backup.log")"
    exit 0
fi
echo fail >"$STATE/backup.status"
"$HOME/.local/bin/fili-shell" bar refresh 18
notify-send -u critical -a backup "$(t 'NAS backup failed')" "$(tail -n 2 "$STATE/backup.err" | tr '\n' ' ')"
exit 1
