#!/bin/sh
# Internal panel at login. Usage: fili-internal-panel [apply]
# Writes ~/.config/niri/internal-panel.kdl (included by niri's config.kdl), run by ~/.zprofile just before niri starts.
# The graphics card drives a limited number of displays (three pipes on Intel Ice Lake, the T2 MacBooks). niri keeps the
# pipe of the internal panel reserved even when the panel is turned off afterwards, so with the panel on at login, the
# third external display of a dock gets no pipe (it shows a copy of another one). Turning the panel off from the very
# start frees its pipe: when FILI_INTERNAL_OFF_AT or more external displays are connected at login, the file turns the
# internal panel off. Fewer displays, or none: empty file, the panel stays on.
# FILI_INTERNAL_OFF_AT (default 3): number of external displays from which the internal panel starts off, 0 = never.
# FILI_DRM_DIR (default /sys/class/drm): where the connectors are read (tests).
set -u
drm="${FILI_DRM_DIR:-/sys/class/drm}"
min="${FILI_INTERNAL_OFF_AT:-3}"
out="${XDG_CONFIG_HOME:-$HOME/.config}/niri/internal-panel.kdl"

ext=0
internal=""
for d in "$drm"/card*-*; do
    [ "$(cat "$d/status" 2>/dev/null)" = connected ] || continue
    n=${d##*/}
    n=${n#card*-}
    case "$n" in
        eDP-*|LVDS-*|DSI-*) internal=${internal:-$n} ;;
        *) ext=$((ext + 1)) ;;
    esac
done

mkdir -p "$(dirname "$out")"
{
    echo "// Generated by fili-internal-panel at login, do not edit here"
    if [ -n "$internal" ] && [ "$min" -gt 0 ] && [ "$ext" -ge "$min" ]; then
        echo "output \"$internal\" { off; }"
    fi
} > "$out.new" && mv "$out.new" "$out"
