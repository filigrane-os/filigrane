#!/bin/sh
# Internal panel off when a dock brings enough displays. Usage: fili-internal-panel [apply|watch]
#   apply  (default) writes ~/.config/niri/internal-panel.kdl from the displays connected now. Run by ~/.zprofile just
#          before niri starts, so that the panel is off from the very start of the session.
#   watch  apply, then apply again on every display plug/unplug (udevadm monitor). Started by niri (spawn-at-startup):
#          unplugging the dock empties the file and niri, which re-reads its config, turns the panel back on.
# The graphics card drives a limited number of displays (three pipes on Intel Ice Lake, the T2 MacBooks). niri keeps the
# pipe of the internal panel reserved even when the panel is turned off afterwards, so with the panel on at login, the
# third external display of a dock gets no pipe (it shows a copy of another one). Turning the panel off from the very
# start frees its pipe.
# Threshold: number of external displays, on the card of the internal panel, from which the panel is turned off.
# FILI_INTERNAL_OFF_AT if set, else `off-at = N` in ~/.config/filigrane/internal-panel.toml (set by the hardware layer of
# the machines that need it), else 0 = never.
# The file is rewritten only when its content changes (niri re-reads its config on every write). While the panel is
# off, an `output` block of the same panel in local.kdl is ignored (niri uses the first block that matches); it applies
# again as soon as the panel is back on.
# FILI_DRM_DIR (default /sys/class/drm): where the connectors are read (tests).
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
set -u
drm="${FILI_DRM_DIR:-/sys/class/drm}"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/filigrane/internal-panel.toml"
out="${XDG_CONFIG_HOME:-$HOME/.config}/niri/internal-panel.kdl"

threshold() {
    v="${FILI_INTERNAL_OFF_AT:-}"
    if [ -z "$v" ] && [ -r "$conf" ]; then
        v="$(sed -n 's/^[[:space:]]*off-at[[:space:]]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$conf" | tail -n 1)"
    fi
    case "${v:-0}" in
        *[!0-9]*) printf '%s\n' "$(t 'fili-internal-panel: invalid threshold "%s" (a number is expected), ignored' "$v")" >&2; echo 0 ;;
        *) echo "${v:-0}" ;;
    esac
}

apply() {
    min="$(threshold)"
    # The internal panel and its card (card0-eDP-1 -> card0): only the displays of that card share its pipes
    internal=""
    card=""
    for d in "$drm"/card*-eDP-* "$drm"/card*-LVDS-* "$drm"/card*-DSI-*; do
        [ "$(cat "$d/status" 2>/dev/null)" = connected ] || continue
        n=${d##*/}
        card=${n%%-*}
        internal=${n#"$card"-}
        break
    done
    ext=0
    if [ -n "$internal" ]; then
        for d in "$drm/$card"-*; do
            n=${d##*/}
            n=${n#"$card"-}
            case "$n" in eDP-*|LVDS-*|DSI-*) continue ;; esac
            [ "$(cat "$d/status" 2>/dev/null)" = connected ] && ext=$((ext + 1))
        done
    fi

    mkdir -p "$(dirname "$out")"
    {
        echo "// Generated by fili-internal-panel, do not edit here"
        if [ -n "$internal" ] && [ "$min" -gt 0 ] && [ "$ext" -ge "$min" ]; then
            echo "output \"$internal\" { off; }"
        fi
    } > "$out.new" || return 1
    if cmp -s "$out.new" "$out"; then
        rm -f "$out.new"
    else
        mv "$out.new" "$out"
    fi
}

case "${1:-apply}" in
    apply) apply ;;
    watch)
        apply
        # One line per DRM event (an MST dock can send one per second: apply only reads sysfs and rarely writes)
        udevadm monitor --udev --subsystem-match=drm | while read -r _; do apply; done ;;
    *) printf '%s\n' "$(t 'Usage: fili-internal-panel [apply|watch]')" >&2; exit 1 ;;
esac
