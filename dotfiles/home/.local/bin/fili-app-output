#!/bin/sh
# Monitor on which an application opens (niri window rule open-on-output). Usage:
# fili-app-output here [APP_ID]    from now on, the application (default: focused window) opens on the monitor it is on
# fili-app-output forget [APP_ID]  the application opens wherever niri decides again
# fili-app-output list             saved choices, "APP_ID<TAB>monitor"
# fili-app-output pin              the focused workspace gets a name and stays on the monitor it is on (named workspace
#                                  with open-on-output: it survives being empty and returns there when the monitor is plugged in)
# fili-app-output unpin            the focused workspace is unpinned (its name stays until niri restarts)
# fili-app-output set APP_ID MONITOR      the application opens on MONITOR ("make model serial")
# fili-app-output set-workspace APP_ID NAME  the application opens on the named workspace NAME
# fili-app-output numbered [COUNT MONITOR]...  workspaces numbered across the monitors: COUNT named workspaces
#                                  "1", "2"... on each MONITOR, in the order given (left to right); the bindings of
#                                  the niri config that go to workspace N by index then go to the workspace named N.
#                                  Without arguments: numbering off.
# fili-app-output layout APP_ID MODE  how its new windows are placed: left, right (tiled, first or last column of the
#                                  workspace: moved there by fili-shell, FiliPlacement.qml, niri has no such rule),
#                                  full (maximized to the edges), float (floating, centred);
#                                  none (or empty) = tiled as niri decides
# fili-app-output json             saved choices: {"apps":[{"app","output"|"workspace","layout"?}],"workspaces":[{"name","output"}]}
#                                  (an application with only a layout has neither output nor workspace)
# fili-app-output apply            rewrites ~/.config/niri/app-outputs.kdl from the saved choices (bootstrap.sh)
# Choices: $XDG_STATE_HOME/filigrane/app-outputs (applications on a monitor), app-workspaces (applications on a named
# workspace), app-layouts (placement of the windows) and workspace-outputs (pinned and numbered workspaces). The monitor is stored by "make model serial" (as niri names it),
# not by connector (DP-6), which changes with the port. niri re-reads the generated file by itself: windows opened
# afterwards follow the rule, open windows stay where they are.
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
set -u
dir="${XDG_STATE_HOME:-$HOME/.local/state}/filigrane"
state="$dir/app-outputs"
wsstate="$dir/workspace-outputs"
appws="$dir/app-workspaces"
layouts="$dir/app-layouts"
niridir="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
out="$niridir/app-outputs.kdl"
binds="$niridir/workspace-binds.kdl"
tab="$(printf '\t')"

notify() { [ -z "${WAYLAND_DISPLAY:-}" ] || notify-send -a fili-app-output "$1" "$2" 2>/dev/null; }

# Focused workspace: "name|output connector" (| and not a tab: an empty name must stay a field)
focused_workspace() {
    niri msg --json workspaces | jq -r '.[] | select(.is_focused) | "\(.name // "")|\(.output)"'
}
monitor_of() { # connector -> "make model serial"
    niri msg --json outputs | jq -r --arg c "$1" '.[$c] // empty | "\(.make) \(.model) \(.serial // "Unknown")"'
}

# Name of the monitor of the focused window: "make model serial" ("Unknown" without serial)
focused_monitor() {
    ws="$(niri msg --json focused-window | jq -r '.workspace_id // empty')"
    [ -n "$ws" ] || return 1
    conn="$(niri msg --json workspaces | jq -r --argjson id "$ws" '.[] | select(.id == $id) | .output // empty')"
    [ -n "$conn" ] || return 1
    niri msg --json outputs | jq -r --arg c "$conn" '.[$c] // empty | "\(.make) \(.model) \(.serial // "Unknown")"'
}

# ~/.config/niri/app-outputs.kdl: one window rule per saved application
write_rules() {
    mkdir -p "${out%/*}"
    {
        echo "// Generated by fili-app-output, do not edit here"
        [ -r "$state" ] && while IFS="$tab" read -r wapp wmon; do
            [ -n "$wapp" ] && [ -n "$wmon" ] || continue
            # Regular expression for the exact app-id; no quote or # allowed in the raw strings
            case "$wapp$wmon" in *'"'* | *'#'*) continue ;; esac
            re="$(printf '%s' "$wapp" | sed 's/[][\.^$*+?(){}|]/\\&/g')"
            printf 'window-rule {\n    match app-id=r#"^%s$"#\n    open-on-output "%s"\n}\n' "$re" "$wmon"
        done < "$state"
        [ -r "$appws" ] && while IFS="$tab" read -r wapp wname; do
            [ -n "$wapp" ] && [ -n "$wname" ] || continue
            case "$wapp$wname" in *'"'* | *'#'* | *'\'*) continue ;; esac
            re="$(printf '%s' "$wapp" | sed 's/[][\.^$*+?(){}|]/\\&/g')"
            printf 'window-rule {\n    match app-id=r#"^%s$"#\n    open-on-workspace "%s"\n}\n' "$re" "$wname"
        done < "$appws"
        [ -r "$layouts" ] && while IFS="$tab" read -r wapp wmode; do
            [ -n "$wapp" ] || continue
            case "$wapp" in *'"'* | *'#'*) continue ;; esac
            re="$(printf '%s' "$wapp" | sed 's/[][\.^$*+?(){}|]/\\&/g')"
            body="$(layout_rule "$wmode")" || continue
            printf 'window-rule {\n    match app-id=r#"^%s$"#\n%s\n}\n' "$re" "$body"
        done < "$layouts"
        [ -r "$wsstate" ] && while IFS="$tab" read -r wname wmon; do
            [ -n "$wname" ] && [ -n "$wmon" ] || continue
            case "$wname$wmon" in *'"'* | *'\'*) continue ;; esac
            printf 'workspace "%s" {\n    open-on-output "%s"\n}\n' "$wname" "$wmon"
        done < "$wsstate"
    } > "$out.new"
    mv "$out.new" "$out" # atomic: niri watches this file and must never see it half written
    write_binds
}

# Body of the window rule of a placement (fails for an unknown one, and for left / right, which are not niri rules)
layout_rule() {
    case "$1" in
    full) printf '    open-maximized-to-edges true' ;;
    float) printf '    open-floating true' ;;
    *) return 1 ;;
    esac
}

# Highest numbered workspace (names that are numbers), 0 when the numbering is off
numbered_max() {
    [ -r "$wsstate" ] || { echo 0; return; }
    awk -F '\t' '$1 ~ /^[0-9]+$/ && $2 != "" && $1 + 0 > m { m = $1 + 0 } END { print m + 0 }' "$wsstate"
}

# ~/.config/niri/workspace-binds.kdl (included after local.kdl): with numbered workspaces, every binding of the niri
# config that goes to workspace N by index (focus-workspace 3) is repeated with the name ("3"), which wins (a later
# binding of the same key replaces the earlier one). Up to 9, not only the pinned ones: the fili-shell gives a temporary
# number to the workspaces created on the fly (Niri.qml). Empty without numbering: the bindings by index apply again.
write_binds() {
    mkdir -p "$niridir"
    max="$(numbered_max)"
    mkdir -p "$dir"; echo "$max" > "$dir/numbered-max"
    [ "$max" -gt 0 ] && max=9
    {
        echo "// Generated by fili-app-output (numbered workspaces), do not edit here"
        if [ "$max" -gt 0 ]; then
            echo "binds {"
            for f in "$niridir/config.kdl" "$niridir/local.kdl"; do
                [ -r "$f" ] && cat "$f"
            done | MAX="$max" awk '
                $0 !~ /^[ \t]*\/\// && match($0, /\{ *(focus-workspace|move-column-to-workspace|move-window-to-workspace) +[0-9]+; *\}/) {
                    n = $0; sub(/^.*-workspace +/, "", n); sub(/;.*$/, "", n)
                    if (n + 0 < 1 || n + 0 > ENVIRON["MAX"] + 0) next
                    line = $0; sub(/^[ \t]+/, "", line); sub(/ *\/\/.*$/, "", line)
                    if (line ~ /move-(column|window)-to-workspace/) {
                        kind = (line ~ /move-column/) ? "column" : "window"
                        sub(/\{ *move-(column|window)-to-workspace +[0-9]+; *\}/, "{ spawn \"fili-app-output\" \"move-to\" \"" kind "\" \"" n "\"; }", line)
                    } else sub(/-workspace +[0-9]+;/, "-workspace \"" n "\";", line)
                    print "    " line
                }'
            echo "}"
        fi
    } > "$binds.new"
    mv "$binds.new" "$binds"
}

# Pinned workspaces already open stay where they are when niri re-reads open-on-output: each one is moved to the
# display of its monitor, and the numbered ones put in order on it (1, 2... at the top). The niri CLI reads "2" as an
# index, never as a name, hence requests by id on the niri socket (socat; $FILI_NIRI_IPC replaces it in the tests).
# The active workspace of each display and the focus are given back afterwards.
niri_ipc() {
    if [ -n "${FILI_NIRI_IPC:-}" ]; then $FILI_NIRI_IPC; else socat - "UNIX-CONNECT:$NIRI_SOCKET" > /dev/null; fi
}
place_workspaces() {
    [ -n "${NIRI_SOCKET:-}" ] && [ -r "$wsstate" ] || return 0
    [ -n "${FILI_NIRI_IPC:-}" ] || command -v socat > /dev/null || return 0
    outs="$(niri msg --json outputs)" || return 0
    # Wanted: [{name, conn}] for the monitors that are connected
    want="$(jq -Rn --argjson outs "$outs" '
        ([$outs[] | { key: "\(.make) \(.model) \(.serial // "Unknown")", value: .name }] | from_entries) as $conn
        | [inputs | split("\t") | select(.[0] != "" and (.[1] // "") != "") | { name: .[0], conn: $conn[.[1]] } | select(.conn)]' < "$wsstate")"
    # niri creates the new named workspaces when it re-reads the config: wait for them (at most 3 s)
    i=0
    while ws="$(niri msg --json workspaces)" && [ "$i" -lt 30 ] \
        && ! jq -e --argjson want "$want" '[.[].name] as $n | $want | all(.name as $w | $n | index($w))' > /dev/null <<EOT
$ws
EOT
    do i=$((i + 1)); sleep 0.1; done
    before="$ws"
    moves="$(jq -c --argjson want "$want" '. as $ws | $want[] as $w | $ws[] | select(.name == $w.name and .output != $w.conn)
        | { Action: { MoveWorkspaceToMonitor: { output: $w.conn, reference: { Id: .id } } } }' <<EOT
$ws
EOT
)"
    [ -z "$moves" ] || { printf '%s\n' "$moves" | while IFS= read -r m; do printf '%s\n' "$m" | niri_ipc; done; ws="$(niri msg --json workspaces)"; }
    order="$(jq -c --argjson want "$want" '. as $ws | $want | map(select(.name | test("^[0-9]+$"))) | group_by(.conn)[]
        | sort_by(.name | tonumber) | to_entries[] | (.key + 1) as $i | .value as $w | $ws[]
        | select(.name == $w.name and .idx != $i) | { Action: { MoveWorkspaceToIndex: { index: $i, reference: { Id: .id } } } }' <<EOT
$ws
EOT
)"
    [ -n "$order" ] && printf '%s\n' "$order" | while IFS= read -r m; do printf '%s\n' "$m" | niri_ipc; done
    [ -n "$moves$order" ] || return 0
    # Active workspace of each display back, the focused one last (FocusWorkspace also focuses its display)
    jq -c '(map(select(.is_active and (.is_focused | not))) + map(select(.is_focused)))[]
        | { Action: { FocusWorkspace: { reference: { Id: .id } } } }' <<EOT | while IFS= read -r m; do printf '%s\n' "$m" | niri_ipc; done
$before
EOT
}

# without FILE KEY: FILE minus the line whose first field is exactly KEY (a plain comparison: no regex, no escapes)
without() {
    [ -r "$1" ] || return 0
    KEY="$2" awk -F '\t' '$1 != ENVIRON["KEY"]' "$1" > "$1.new" && mv "$1.new" "$1"
}
has() { # FILE KEY: is there a line whose first field is KEY?
    [ -r "$1" ] && KEY="$2" awk -F '\t' '$1 == ENVIRON["KEY"] { f = 1 } END { exit !f }' "$1"
}
drop() { without "$state" "$1"; } # APP_ID: state without this application

app="${2:-}"
case "${1:-list}" in
here | forget)
    if [ -z "$app" ]; then
        app="$(niri msg --json focused-window | jq -r '.app_id // empty')"
        [ -n "$app" ] || { t 'No window with an application name has the focus.' >&2; echo >&2; exit 1; }
    fi
    mkdir -p "$dir"
    touch "$state"
    drop "$app"; without "$appws" "$app"
    [ "$1" = forget ] && without "$layouts" "$app"
    if [ "$1" = here ]; then
        mon="$(focused_monitor)" || { t 'Monitor of the window not found.' >&2; echo >&2; exit 1; }
        printf '%s\t%s\n' "$app" "$mon" >> "$state"
        msg="$(t '%s now opens on %s.' "$app" "$mon")"
    else
        msg="$(t '%s opens wherever niri decides again.' "$app")"
    fi
    write_rules
    notify "$(t 'Monitor of the application')" "$msg"
    printf '%s\n' "$msg"
    ;;
pin)
    IFS="|" read -r name conn <<EOT
$(focused_workspace)
EOT
    [ -n "$conn" ] || { t 'No focused workspace found.' >&2; echo >&2; exit 1; }
    mon="$(monitor_of "$conn")"
    [ -n "$mon" ] || { t 'Monitor of the workspace not found.' >&2; echo >&2; exit 1; }
    mkdir -p "$dir"; touch "$wsstate"
    if [ -z "$name" ]; then
        model="$(niri msg --json outputs | jq -r --arg c "$conn" '.[$c].model // "monitor"')"
        base="ws-$(printf '%s' "$model" | tr -c 'A-Za-z0-9' '-' | tr 'A-Z' 'a-z' | sed 's/-*$//')"
        name="$base"; n=1
        while has "$wsstate" "$name"; do n=$((n + 1)); name="$base-$n"; done
        niri msg action set-workspace-name "$name" || exit 1
    fi
    without "$wsstate" "$name"
    printf '%s\t%s\n' "$name" "$mon" >> "$wsstate"
    write_rules
    msg="$(t 'Workspace %s stays on %s.' "$name" "$mon")"
    notify "$(t 'Monitor of the workspace')" "$msg"
    printf '%s\n' "$msg"
    ;;
unpin)
    IFS="|" read -r name _ <<EOT
$(focused_workspace)
EOT
    [ -n "$name" ] || exit 0
    without "$wsstate" "$name"
    write_rules
    msg="$(t 'Workspace %s is no longer pinned to a monitor.' "$name")"
    notify "$(t 'Monitor of the workspace')" "$msg"
    printf '%s\n' "$msg"
    ;;
set | set-workspace)
    [ -n "$app" ] && [ -n "${3:-}" ] || { echo "usage: fili-app-output $1 APP_ID ${1#set-}" >&2; exit 2; }
    case "$app${3}" in *"$tab"* | *'"'* | *'#'* | *'\'*) t 'Invalid name.' >&2; echo >&2; exit 2 ;; esac
    mkdir -p "$dir"; touch "$state" "$appws"
    drop "$app"; without "$appws" "$app"
    if [ "$1" = set ]; then printf '%s\t%s\n' "$app" "$3" >> "$state"; else printf '%s\t%s\n' "$app" "$3" >> "$appws"; fi
    write_rules
    ;;
layout)
    [ -n "$app" ] || { echo "usage: fili-app-output layout APP_ID left|right|full|float|none" >&2; exit 2; }
    case "$app" in *"$tab"* | *'"'* | *'#'* | *'\'*) t 'Invalid name.' >&2; echo >&2; exit 2 ;; esac
    mode="${3:-none}"
    case "$mode" in left | right | full | float | none) ;; *) echo "fili-app-output layout: invalid mode: $mode" >&2; exit 2 ;; esac
    mkdir -p "$dir"; touch "$layouts"
    without "$layouts" "$app"
    [ "$mode" = none ] || printf '%s\t%s\n' "$app" "$mode" >> "$layouts"
    write_rules
    ;;
numbered)
    shift
    mkdir -p "$dir"; touch "$wsstate"
    # The numbered entries are replaced; the other pinned workspaces stay
    awk -F '\t' '$1 !~ /^[0-9]+$/' "$wsstate" > "$wsstate.new"
    n=0
    while [ $# -ge 2 ]; do
        case "$1" in '' | *[!0-9]*) echo "fili-app-output numbered: invalid count: $1" >&2; rm -f "$wsstate.new"; exit 2 ;; esac
        case "$2" in '' | *'"'* | *'\'* | *"$tab"*) echo "fili-app-output numbered: invalid monitor: $2" >&2; rm -f "$wsstate.new"; exit 2 ;; esac
        i=0
        while [ "$i" -lt "$1" ]; do i=$((i + 1)); n=$((n + 1)); printf '%s\t%s\n' "$n" "$2" >> "$wsstate.new"; done
        shift 2
    done
    mv "$wsstate.new" "$wsstate"
    write_rules
    place_workspaces
    ;;
move-to)
    # Move the focused column (or window) to the workspace named N, creating it first when it does not exist: the
    # empty workspace niri keeps at the end of the focused display takes the name, then both actions go in one
    # request (the fili-shell would otherwise drop the name of the still empty workspace)
    kind="${2:-}"; num="${3:-}"
    case "$kind" in column | window) ;; *) echo "usage: fili-app-output move-to column|window N" >&2; exit 2 ;; esac
    case "$num" in [1-9]) ;; *) echo "fili-app-output move-to: invalid number: $num" >&2; exit 2 ;; esac
    ws="$(niri msg --json workspaces)" || exit 1
    id="$(jq -r --arg n "$num" 'if any(.[]; .name == $n) then empty else
        ([.[] | select(.is_focused)][0].output) as $o
        | ([.[] | select(.output == $o and .name == null)] | sort_by(.idx) | last | .id) // empty end' <<EOT
$ws
EOT
)"
    {
        [ -z "$id" ] || printf '{"Action":{"SetWorkspaceName":{"name":"%s","workspace":{"Id":%s}}}}\n' "$num" "$id"
        if [ "$kind" = column ]; then
            printf '{"Action":{"MoveColumnToWorkspace":{"reference":{"Name":"%s"},"focus":true}}}\n' "$num"
        else
            printf '{"Action":{"MoveWindowToWorkspace":{"window_id":null,"reference":{"Name":"%s"},"focus":true}}}\n' "$num"
        fi
    } | niri_ipc
    ;;
json)
    {
        [ -r "$state" ] && awk -F '\t' '$1 != "" && $2 != "" { print "o\t" $0 }' "$state"
        [ -r "$appws" ] && awk -F '\t' '$1 != "" && $2 != "" { print "w\t" $0 }' "$appws"
        [ -r "$wsstate" ] && awk -F '\t' '$1 != "" && $2 != "" { print "p\t" $0 }' "$wsstate"
        [ -r "$layouts" ] && awk -F '\t' '$1 != "" && $2 != "" { print "l\t" $0 }' "$layouts"
    } | jq -Rn '[inputs | split("\t")] as $l
        | ([$l[] | select(.[0] == "l") | { key: .[1], value: .[2] }] | from_entries) as $lay
        | ([$l[] | select(.[0] == "o") | { app: .[1], output: .[2] }] + [$l[] | select(.[0] == "w") | { app: .[1], workspace: .[2] }]) as $a
        | { apps: ($a + [$lay | keys[] | select(. as $k | $a | all(.app != $k)) | { app: . }]
                | map(if $lay[.app] then . + { layout: $lay[.app] } else . end)),
            workspaces: [$l[] | select(.[0] == "p") | { name: .[1], output: .[2] }] }'
    ;;
list) cat "$state" 2>/dev/null ;;
apply) write_rules ;;
*) echo "usage: fili-app-output [here [APP_ID]|forget [APP_ID]|set APP_ID MONITOR|set-workspace APP_ID NAME|layout APP_ID MODE|numbered [COUNT MONITOR]...|move-to column|window N|pin|unpin|list|json|apply]" >&2; exit 2 ;;
esac
