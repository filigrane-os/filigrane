#!/bin/sh
# Region formats (the "Region" page of Settings): how dates, numbers, money, units and paper are written, apart from the
# language of the interface (fili-lang) and from the keyboard (fili-keymap). Usage:
# fili-region [get]          the region chosen (a locale such as fr_CH.UTF-8), empty when the formats follow the language
# fili-region list           the regions offered, as JSON [{locale, code, current}] (the glibc locales that are installed)
# fili-region set LOCALE     fr_CH, en_GB.UTF-8... or "language" (the formats follow the language again)
# fili-region zone           the time zone (read only: it is a system setting, TIMEZONE of config.env)
# The choice is $XDG_STATE_HOME/filigrane/region; fili-lang writes it as LC_TIME, LC_NUMERIC, LC_MONETARY, LC_MEASUREMENT and
# LC_PAPER in ~/.config/niri/locale.kdl, so applications started afterwards use it; the fili-shell follows the file live for its dates.
# A region is offered only when its glibc locale exists (LOCALES of config.env, generated by bootstrap.sh).
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
set -u
dir="${XDG_STATE_HOME:-$HOME/.local/state}/filigrane"
state="$dir/region"

# Installed UTF-8 locales as language_COUNTRY.UTF-8 (the generic C and POSIX are not regions)
installed() { locale -a 2> /dev/null | sed -n 's/^\([a-z][a-z]*_[A-Z][A-Z]*\)\.\(utf8\|UTF-8\)$/\1.UTF-8/p' | sort -u; }
current() { { read -r cur < "$state"; } 2> /dev/null || cur=""; printf '%s\n' "$cur"; }

case "${1:-get}" in
get) current ;;
list)
    cur="$(current)"
    installed | while read -r loc; do
        jq -nc --arg l "$loc" --arg c "${loc%%.*}" --arg cur "$cur" '{locale: $l, code: $c, current: ($l == $cur)}'
    done | jq -sc .
    ;;
set)
    [ $# -ge 2 ] || { t 'usage: fili-region set LOCALE|language' >&2; echo >&2; exit 2; }
    mkdir -p "$dir"
    case "$2" in
    language) loc="" ;;
    *)
        want="${2%%.*}"
        loc="$(installed | grep -x "$want.UTF-8")" || { t 'region not installed: %s (add it to LOCALES in config.env, then ./bootstrap.sh)' "$2" >&2; echo >&2; exit 1; }
        ;;
    esac
    # Written in place (no rename): the fili-shell follows the file through inotify
    printf '%s\n' "$loc" > "$state"
    "${0%/*}/fili-lang" apply
    "${0%/*}/fili-shell" lang 2> /dev/null
    [ -z "${WAYLAND_DISPLAY:-}" ] || notify-send -a fili-region "$(t 'Region: %s' "${loc:-$(t 'same as the language')}")" "$(t 'New windows use it; restart open apps to switch them.')" 2> /dev/null
    ;;
zone)
    z="$(readlink -f /etc/localtime 2> /dev/null)"
    printf '%s\n' "${z#*/zoneinfo/}"
    ;;
*) t 'usage: fili-region [get|list|set LOCALE|zone]' >&2; echo >&2; exit 2 ;;
esac
