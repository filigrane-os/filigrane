#!/bin/sh
# Light wallpaper (swaybg, static). Usage: wallpaper [image]
# Without an argument: last image chosen, else the Filigrane background (scripts/brand-assets.sh), light or dark depending on fili-theme.
dir="$HOME/.local/share/wallpapers"
state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
img="${1:-$(cat "$state" 2>/dev/null)}"
if [ "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/filigrane/theme" 2>/dev/null)" = light ]; then
    def="$dir/filigrane-clair.png" bg=f3f1ec
else
    def="$dir/filigrane.png" bg=1c222b
fi
case "$img" in "$dir/filigrane.png" | "$dir/filigrane-clair.png") img="$def" ;; esac
[ -f "$img" ] || img="$def"
mkdir -p "$(dirname "$state")"
printf '%s\n' "$img" > "$state"
pkill -x swaybg 2>/dev/null
exec swaybg -c "$bg" -i "$img" -m fill
