#!/bin/sh
# Client of the fili-shell (Quickshell: fili-bar, fili-notification, fili-notification-center, fili-launcher, fili-tooltip,
# fili-calendar). Writes a line into the named pipe read by ~/.config/quickshell (FiliShell.qml), without starting the
# Qt client `qs ipc` (heavier). Replies come back through a pipe of their own for the request. Without a running shell,
# commands without a reply are ignored.
# Usage:
# fili-shell bar refresh N...                       refreshes the fili-bar modules (ex-`pkill -RTMIN+N waybar`)
# fili-shell notification dnd on|off|toggle         do not disturb
# fili-shell notification dismiss-all | dismiss SUMMARY | center (opens/closes the fili-notification-center)
# fili-shell panel network|audio|bluetooth|power|monitor|keyboard|display|close   opens/closes a fili-panel (under its module)
# fili-shell panel toggle                           reopens the last fili-panel or closes (Mod+A, keyboard navigation)
# fili-shell notification history                   history as JSON (fields of makoctl history -j)
# fili-shell launcher [fuzzel options]                  fili-launcher in the style of `fuzzel --dmenu`: entries on stdin, choice on
# stdout, code 1 if cancelled, 10 for Shift+Backspace. Options: --prompt P, --prompt-only P, --lines N,
# --width N (characters), --font F, --no-sort, --with-nth N, --accept-nth N, --search-nth N (tab-separated columns; the --search-nth column
# is searched without being displayed: keywords);
# the other fuzzel options are ignored. Icons: extended dmenu protocol "text\0icon\037path".
# fili-shell launcher close                             closes the fili-launcher if it is open (code 0), else code 1
# fili-shell appmenu [close]                        opens the menu of the active application from the keyboard (Mod+F10), or closes it
# fili-shell hotkeys                                opens/closes the keyboard shortcuts window (fili-hotkeys)
# fili-shell chat [ACTION]                          fili-chat drawer: toggle (default), show, close, new, sessions, rename, stop, float, dock... (Mod+Y: `fili-chat toggle`, which also notes the active application)
# fili-shell settings [PAGE]                        opens/closes the Settings window (fili-settings), on page PAGE (display, language, power, files, about)
# fili-shell about                                  opens/closes the "About" window (fili-about: Filigrane, system, machine)
# fili-shell lang                                   re-reads the chosen language (fili-lang)
# fili-shell taskbar [hint|DIGIT]                    taskbar: type the number of a window (Mod+Alt+0..9), release the keys to go there
# fili-shell reload                                 reloads the config
D="${XDG_RUNTIME_DIR:-/tmp}"
F="$D/fili-shell"

send() { # line without blocking: opened read-write (never blocking on a pipe)
    [ -p "$F" ] || return 1
    { printf '%s\n' "$1" >&3; } 3<>"$F"
}
# request COMMAND: sends "COMMAND <reply pipe>" and waits for the reply
request() {
    [ -p "$F" ] && pgrep -x quickshell >/dev/null || return 1
    r="$(mktemp -u "$D/fili-shell.XXXXXX")"
    mkfifo -m 600 "$r" || return 1
    send "$1 $r"
    cat "$r"
    rm -f "$r"
}
usage() { sed -n '6,24p' "$0" >&2; exit 2; }

case "$1 $2" in
    "bar refresh") shift 2; send "bar refresh $*"; exit 0 ;;
    "notification dnd") send "notification dnd ${3:-toggle}"; exit 0 ;;
    "notification dismiss-all"|"notification center") send "$1 $2"; exit 0 ;;
    "notification dismiss") send "notification dismiss $(printf '%s' "$3" | tr '\n' ' ')"; exit 0 ;;
    "panel "*) send "panel $2"; exit 0 ;;
    "notification history") request "notification history"; exit ;;
    "launcher close") [ "$(request "launcher close")" = 1 ]; exit ;;
    "appmenu "*) send "appmenu ${2:-toggle}"; exit 0 ;;
    "hotkeys "*) send "hotkeys toggle"; exit 0 ;;
    "about "*) send "about toggle"; exit 0 ;;
    "settings "*) send "settings${2:+ $2}"; exit 0 ;;
    "chat "*) send "chat ${2:-toggle}${3:+ $3}"; exit 0 ;;
    "lang "*) send "lang reload"; exit 0 ;;
    "taskbar "*) send "taskbar ${2:-hint}"; exit 0 ;;
    "reload "*) send reload; exit 0 ;;
    "launcher "*) shift ;;
    *) usage ;;
esac

# fili-launcher: options as JSON and entries in files read by the shell
prompt=''; only=0; lines=12; width=''; font=''; nosort=0; with=''; accept=''; search=''
while [ $# -gt 0 ]; do
    case "$1" in
        --dmenu|--minimal-lines) ;;
        --prompt) prompt="$2"; shift ;;
        --prompt=*) prompt="${1#*=}" ;;
        --prompt-only) only=1; prompt="$2"; shift ;;
        --lines) lines="$2"; shift ;;
        --width) width="$2"; shift ;;
        --font) font="$2"; shift ;;
        --no-sort) nosort=1 ;;
        --with-nth) with="$2"; shift ;;
        --accept-nth) accept="$2"; shift ;;
        --search-nth) search="$2"; shift ;;
        --placeholder|--nth-delimiter) shift ;;
    esac
    shift
done
in="$(mktemp "$D/fili-launcher.XXXXXX")"
trap 'rm -f "$in" "$in.json"' EXIT
[ "$only" = 1 ] || cat > "$in"
jq -nc --arg p "$prompt" --argjson o "$only" --arg l "$lines" --arg w "$width" --arg f "$font" --argjson s "$nosort" \
    --arg wn "$with" --arg an "$accept" --arg sn "$search" --arg in "$in" \
    '{prompt: $p, promptOnly: ($o == 1), lines: ($l | tonumber? // 12), width: ($w | tonumber? // 0), font: $f,
      noSort: ($s == 1), withNth: ($wn | tonumber? // 0), acceptNth: ($an | tonumber? // 0), searchNth: ($sn | tonumber? // 0), input: $in}' > "$in.json"
out="$(request "launcher open $in.json")" || exit 1
# Reply: exit code on the first line, selection after
rc="${out%%
*}"
case "$out" in *'
'*) sel="${out#*
}" ;; *) sel='' ;; esac
[ -n "$sel" ] && printf '%s\n' "$sel"
exit "${rc:-1}"
