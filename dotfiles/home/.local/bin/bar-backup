#!/bin/sh
# Immediate restic backup from the bar (`bar-backup run`, watch-backup now). The displayed state (idle, active, failed)
# is written by bar-stats (apps/bar-stats, stat backup).
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
[ "$1" = run ] || { echo "usage: bar-backup run" >&2; exit 2; }
pgrep -f '^restic backup' >/dev/null && { notify-send -u low -a backup "$(t 'Backup')" "$(t 'Already running')"; exit 0; }
setsid "$HOME/.local/bin/watch-backup" now >/dev/null 2>&1 &
