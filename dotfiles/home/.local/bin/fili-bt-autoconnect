#!/bin/sh
# fili-bt-autoconnect: connect the paired and trusted Bluetooth devices (keyboard, mouse,
# headset) at session start. BlueZ only reconnects a device when it advertises, so one that
# was already on before the login (or woke up before bluetoothd was ready) stays disconnected.
# Retries a few times, then exits: no resident process.
# $FILI_BTCTL overrides the bluetoothctl command, $FILI_BT_TRIES and $FILI_BT_DELAY the retries (tests).
BTCTL="${FILI_BTCTL:-bluetoothctl}"
tries="${FILI_BT_TRIES:-6}"
delay="${FILI_BT_DELAY:-5}"

# Wait for the adapter (bluetoothd starts in parallel with the session)
i=0
while ! $BTCTL show 2>/dev/null | grep -q 'Powered: yes'; do
    i=$((i + 1))
    [ "$i" -gt "$tries" ] && exit 0
    $BTCTL power on >/dev/null 2>&1
    sleep "$delay"
done

n=0
while [ "$n" -lt "$tries" ]; do
    pending=0
    for addr in $($BTCTL devices Trusted 2>/dev/null | awk '$1 == "Device" { print $2 }'); do
        $BTCTL info "$addr" 2>/dev/null | grep -q 'Paired: yes' || continue
        $BTCTL info "$addr" 2>/dev/null | grep -q 'Connected: yes' && continue
        $BTCTL --timeout 8 connect "$addr" >/dev/null 2>&1 \
            || pending=1
    done
    [ "$pending" = 0 ] && exit 0
    n=$((n + 1))
    sleep "$delay"
done
exit 0
