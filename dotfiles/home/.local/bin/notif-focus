#!/bin/sh
# Click on a notification (Quickshell shell, FiliNotification.qml, after its default action): focuses the window
# of the sending app. Usage: notif-focus <app name> [desktop-entry]. Matching by app name or
# desktop-entry against the app_id or the title of the niri windows (lowercase, no punctuation: "foo-bar" finds the app-id "foobar").
# If the app has the name of a web application (~/.config/webapps/list), its domain is also used to find the window
# (Chrome app-id "chrome-<host>__-Default"), and the webapp is opened if no window exists.
app="$1"
entry="$2"
[ -n "$app$entry" ] || exit 1
url="$(awk -F'|' -v a="$app" '
    BEGIN { a = tolower(a) }
    /^#/ || NF < 2 { next }
    { n = $1; u = $2; gsub(/^ +| +$/, "", n); gsub(/^ +| +$/, "", u) }
    tolower(n) == a { print u; exit }' "${XDG_CONFIG_HOME:-$HOME/.config}/webapps/list" 2>/dev/null)"
host="${url#*://}"; host="${host%%/*}"
win="$(niri msg -j windows | jq -r --arg a "$app" --arg e "$entry" --arg h "$host" '
    def n: ascii_downcase | gsub("[^a-z0-9]"; "");
    ([$a, $e, $h] | map(n) | map(select(length >= 3))) as $c
    | ($h | n) as $hn
    | map(select(
        (.app_id // "" | n) as $i | (.title // "" | n) as $t
        | if $hn != "" then ($i | contains($hn))
          else any($c[]; . as $x | ($i != "" and ($i | contains($x) or ($x | contains($i)))) or ($t | contains($x))) end))
    | first | .id // empty')"
if [ -n "$win" ]; then
    niri msg action focus-window --id "$win"
elif [ -n "$url" ]; then
    setsid -f "$HOME/.local/bin/webapp" "$url" >/dev/null 2>&1
fi
echo "$(date +%T) app=$app entry=$entry fenêtre=${win:-aucune}" >> "${XDG_RUNTIME_DIR:-/tmp}/notif-focus.log"
exit 0
