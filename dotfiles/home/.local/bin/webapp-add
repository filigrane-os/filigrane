#!/bin/sh
# Adds a web app to the menu.
# webapp-add "WhatsApp" https://web.whatsapp.com [icon]
# icon: icon theme name or PNG/SVG file (copied into the repository). Without an icon: web-browser.
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
[ -n "$1" ] && [ -n "$2" ] || { echo 'usage: webapp-add "Name" URL [icon]' >&2; exit 1; }
name="$1" url="$2" icon="$3"
list="${XDG_CONFIG_HOME:-$HOME/.config}/webapps/list"
[ -f "$list" ] || { t 'list not found: %s (run ./bootstrap.sh --dotfiles-only)\n' "$list" >&2; exit 1; }
if grep -qiE "^[[:space:]]*$(printf '%s' "$name" | sed 's/[][\.*^$/]/\\&/g')[[:space:]]*\|" "$list"; then
    t 'already there: %s\n' "$name" >&2; exit 1
fi
if [ -f "$icon" ]; then
    dir="$(dirname "$(readlink -f "$list")")/icons"
    mkdir -p "$dir" "$(dirname "$list")/icons"
    cp "$icon" "$dir/"
    icon="~/.config/webapps/icons/$(basename "$icon")"
    ln -sfn "$dir/$(basename "$icon")" "$HOME/.config/webapps/icons/$(basename "$icon")"
fi
printf '%s | %s | %s\n' "$name" "$url" "$icon" >> "$list"
webapp-sync
t 'added: %s (web)\n' "$name"
