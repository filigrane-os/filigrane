#!/bin/bash
# Bar alerts: new Proton mails (mail), imminent Proton Calendar events (cal) and messages of the other web apps followed
# by webapp-notify (whatsapp...), in ~/.local/state/alerts/<kind>, read by the bar (AlertModule).
# `bar-alert push <kind> ...` (mail-notify, cal-notify, webapp-notify) adds a line; `bar-alert open <kind>` opens the web app and clears.
# Adding a web app: its name in ~/.config/webapps/notify, then an AlertModule in the user layer
# (users/<login>/dotfiles/config/quickshell/bar/modules/<name>/) and its name in the user's fili-bar.toml.
#   mail: one line "sender<TAB>subject" per mail received since the last click
#   cal:  one line "start epoch<TAB>HH:MM<TAB>title", shown until 5 minutes after the start
D="$HOME/.local/state/alerts"
mkdir -p "$D"
# URL of a web app of the list from its kind (lowercase name without spaces)
webapp_url() { awk -F'|' -v k="$1" '/^#/ || NF < 2 { next } { n = tolower($1); gsub(/[^a-z0-9]/, "", n); if (n == k) { gsub(/^ +| +$/, "", $2); print $2; exit } }' "${XDG_CONFIG_HOME:-$HOME/.config}/webapps/list"; }

case "$1" in
    push)  # bar-alert push mail "sender" "subject" | bar-alert push cal EPOCH HH:MM title
        kind="$2"; shift 2
        printf '%s\t%s\t%s\n' "$@" | sed 's/\t$//' >>"$D/$kind"; exit 0 ;;
    open)
        : >"$D/$2"
        case "$2" in
            mail) exec "$HOME/.local/bin/webapp" https://mail.proton.me ;;
            cal)  exec "$HOME/.local/bin/webapp" https://calendar.proton.me ;;
            *)    exec "$HOME/.local/bin/webapp" "$(webapp_url "$2")" ;;
        esac ;;
    *) echo "usage: bar-alert push KIND CHAMPS... | open KIND" >&2; exit 2 ;;
esac
