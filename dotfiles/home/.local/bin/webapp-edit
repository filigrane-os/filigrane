#!/bin/sh
# Edits a web app of the menu (name, URL, icon); the fields not given are kept.
# webapp-edit "WhatsApp" [--name NEW] [--url URL] [--icon ICON]
# icon: icon theme name or PNG/SVG file (copied next to the list); "-" resets it to web-browser.
# Rewrites the line of ~/.config/webapps/list in place, then webapp-sync.
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
usage() { echo 'usage: webapp-edit "Name" [--name NEW] [--url URL] [--icon ICON]' >&2; exit 1; }
[ -n "$1" ] || usage
name="$1"; shift
new="" url="" icon="" set_icon=0
while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage
    case "$1" in
        --name) new="$2" ;;
        --url) url="$2" ;;
        --icon) icon="$2"; set_icon=1 ;;
        *) usage ;;
    esac
    shift 2
done
list="${XDG_CONFIG_HOME:-$HOME/.config}/webapps/list"
[ -f "$list" ] || { t 'list not found: %s\n' "$list" >&2; exit 1; }
esc() { printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g'; }
pat="^[[:space:]]*$(esc "$name")[[:space:]]*\|"
line="$(grep -iE "$pat" "$list" | head -1)"
[ -n "$line" ] || { t 'not found: %s\n' "$name" >&2; exit 1; }
trim() { printf '%s' "$1" | sed 's/^ *//;s/ *$//'; }
old_name="$(trim "$(printf '%s' "$line" | cut -d'|' -f1)")"
old_url="$(trim "$(printf '%s' "$line" | cut -d'|' -f2)")"
old_icon="$(trim "$(printf '%s' "$line" | cut -d'|' -f3)")"
[ -n "$new" ] || new="$old_name"
[ -n "$url" ] || url="$old_url"
if [ "$new" != "$old_name" ] && grep -qiE "^[[:space:]]*$(esc "$new")[[:space:]]*\|" "$list"; then
    t 'already there: %s\n' "$new" >&2; exit 1
fi
if [ "$set_icon" = 1 ]; then
    if [ "$icon" = "-" ]; then icon=""
    elif [ -f "$icon" ]; then
        dir="$(dirname "$(readlink -f "$list")")/icons"
        mkdir -p "$dir" "$(dirname "$list")/icons"
        base="$(basename "$icon")"
        cp "$icon" "$dir/$base"
        ln -sfn "$dir/$base" "$HOME/.config/webapps/icons/$base"
        icon="~/.config/webapps/icons/$base"
    fi
else
    icon="$old_icon"
fi
# Rewritten with cat: the list is a link to the repository, sed -i would replace it with a file
tmp="$(mktemp)"
while IFS= read -r l; do
    if [ "$l" = "$line" ]; then printf '%s | %s | %s\n' "$new" "$url" "$icon"; else printf '%s\n' "$l"; fi
done < "$list" > "$tmp"
cat "$tmp" > "$list"; rm -f "$tmp"
# Old icon file dropped when nothing uses it any more
case "$old_icon" in
    "~/.config/webapps/icons/"*)
        if [ "$old_icon" != "$icon" ] && ! grep -qF "$old_icon" "$list"; then
            real="$(readlink -f "$HOME/${old_icon#\~/}")"
            rm -f "$HOME/${old_icon#\~/}" "$real"
        fi ;;
esac
webapp-sync
t 'edited: %s (web)\n' "$new"
