#!/bin/sh
# Locks the screen (swaylock, background = current wallpaper). Usage: lock [auto]
# In auto mode (inactivity, sleep): no lock if the current Wi-Fi is in
# ~/.config/lock-trusted (one SSID per line, local file outside the repository). The manual lock always locks.
pgrep -x swaylock >/dev/null && exit 0
if [ "$1" = auto ] && [ -f "$HOME/.config/lock-trusted" ]; then
    dev=$(iwctl station list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '/connected/{print $1; exit}')
    ssid=$(iwctl station "$dev" show 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '/Connected network/{sub(/^.*Connected network +/,""); sub(/ +$/,""); print; exit}')
    [ -n "$ssid" ] && grep -qxF "$ssid" "$HOME/.config/lock-trusted" && exit 0
fi
img=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper" 2>/dev/null)
# Accent colour (fili-theme accent), dark shade (the lock stays dark): ring, keys and typing text
case "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/filigrane/accent" 2>/dev/null)" in
    voile) acc=9dbbd6 ;;
    ardoise) acc=7f9ab6 ;;
    sauge) acc=a3bfa8 ;;
    sable) acc=d2bf92 ;;
    cendre) acc=c98f93 ;;
    *) acc=dbe7f4 ;;
esac
set -- --ring-ver-color "$acc" --key-hl-color "$acc" --text-ver-color "$acc"
if [ -f "$img" ]; then swaylock -f -i "$img" "$@"; else swaylock -f "$@"; fi || exit
# Locked and idle: screen off after one minute (the swayidle one, 10 min, counts from the last
# activity, not from the lock). That swayidle stops at unlock (end of swaylock).
pid=$(pgrep -nx swaylock) || exit 0
setsid -f sh -c 'swayidle timeout 60 "niri msg action power-off-monitors" resume "niri msg action power-on-monitors" &
    s=$!; tail --pid="$1" -f /dev/null; kill "$s"' _ "$pid" >/dev/null 2>&1
