#!/bin/sh
# Session language, changed live, without root or logging out again. Usage:
# fili-lang [get]          code of the current language (en, fr...)
# fili-lang list           languages offered, as JSON [{code, name, locale, available, current}] (keyboard fili-panel, menu)
# fili-lang set CODE       fr, en, fr_CA... or "system" (language of the system, LOCALE of config.env)
# fili-lang apply          rewrites ~/.config/niri/locale.kdl from the saved choice (bootstrap.sh)
# Choice: $XDG_STATE_HOME/filigrane/locale (a locale, "fr_FR.UTF-8"; empty = system), read by the fili-shell (FiliI18n.qml,
# followed live), bar-stats (restarted by the fili-shell), the scripts and the menu (lib/i18n.sh). Applications
# started afterwards by niri receive LANG (~/.config/niri/locale.kdl, re-read by niri) when the glibc locale exists
# (LOCALES of config.env, generated by bootstrap.sh); those already open keep their language until they are restarted.
# Languages offered: English and each catalog of the fili-shell (~/.config/quickshell/i18n/<code>.json, name: "@name").
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
set -u
dir="${XDG_STATE_HOME:-$HOME/.local/state}/filigrane"
state="$dir/locale"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
cats="$cfg/quickshell/i18n"

# glibc locale installed for a language or a locale: the requested one, else CODE_CODE (fr_FR), else the first
# of the language; en: en_US, en_GB, then C.UTF-8 (always there). Empty output if none.
installed() {
    l="${1%%.*}"; code="${l%%_*}"
    have="$(locale -a 2>/dev/null | sed -n 's/\.\(utf8\|UTF-8\)$//p')"
    for c in "$l" "${code}_$(printf '%s' "$code" | tr '[:lower:]' '[:upper:]')" en_US en_GB; do
        case "$c" in "$code"_* | "$code") ;; *) continue ;; esac
        printf '%s\n' "$have" | grep -qx "$c" && { echo "$c.UTF-8"; return; }
    done
    c="$(printf '%s\n' "$have" | grep -m1 "^${code}_")" && { echo "$c.UTF-8"; return; }
    [ "$code" = en ] && echo C.UTF-8
}
current() {
    { read -r cur < "$state"; } 2>/dev/null || cur=""
    [ -n "$cur" ] || cur="${LC_ALL:-${LC_MESSAGES:-${LANG:-C}}}"
    cur="${cur%%[_.@]*}"
    case "$cur" in '' | *[!a-z]*) cur=en ;; esac
    echo "$cur"
}
# ~/.config/niri/locale.kdl: LANG of the applications started by niri (empty: the one of the system)
niri_env() {
    mkdir -p "$cfg/niri"
    { read -r loc < "$state"; } 2>/dev/null || loc=""
    [ -z "$loc" ] || loc="$(installed "$loc")"
    {
        echo "// Généré par fili-lang, ne pas modifier ici"
        if [ -n "$loc" ]; then printf 'environment {\n    LANG "%s"\n}\n' "$loc"; else echo "// Langue du système (/etc/locale.conf)"; fi
    } > "$cfg/niri/locale.kdl"
    # Programs started through D-Bus (portals, keyring)
    [ -z "$loc" ] || [ -z "${WAYLAND_DISPLAY:-}" ] || dbus-update-activation-environment "LANG=$loc" 2>/dev/null
}

case "${1:-get}" in
get) current ;;
list)
    cur="$(current)"
    {
        printf 'en\tEnglish\n'
        for f in "$cats"/*.json; do
            [ -r "$f" ] || continue
            c="${f##*/}"; c="${c%.json}"
            printf '%s\t%s\n' "$c" "$(jq -r --arg c "$c" '.["@name"] // $c' "$f")"
        done
    } | while IFS="$(printf '\t')" read -r code name; do
        loc="$(installed "$code")"
        jq -nc --arg c "$code" --arg n "$name" --arg l "$loc" --arg cur "$cur" \
            '{code: $c, name: $n, locale: $l, available: ($l != ""), current: ($c == $cur)}'
    done | jq -sc .
    ;;
set)
    [ $# -ge 2 ] || { echo "usage: fili-lang set CODE|system" >&2; exit 2; }
    mkdir -p "$dir"
    # Written in place (no rename): the fili-shell follows the file through inotify
    case "$2" in
    system) : > "$state" ;;
    *_*) printf '%s\n' "$2" > "$state" ;;
    *)
        loc="$(installed "$2")"
        [ -n "$loc" ] || loc="${2}_$(printf '%s' "$2" | tr '[:lower:]' '[:upper:]').UTF-8"
        printf '%s\n' "$loc" > "$state"
        ;;
    esac
    niri_env
    # fili-shell: re-reads the choice (without waiting for inotify)
    "${0%/*}/fili-shell" lang 2>/dev/null
    # Messages in the new language
    unset FILI_LANG
    # shellcheck source=/dev/null
    [ -r "$FILI_LIB/i18n.sh" ] && . "$FILI_LIB/i18n.sh"
    { read -r loc < "$state"; } 2>/dev/null || loc=""
    if [ -n "$loc" ] && [ -z "$(installed "$loc")" ]; then
        msg="$(t 'Filigrane is translated; dates and other apps stay in the system language until ./bootstrap.sh generates %s.' "$loc")"
    else
        msg="$(t 'New windows use it; restart open apps to switch them.')"
    fi
    [ -z "${WAYLAND_DISPLAY:-}" ] || notify-send -a fili-lang "$(t 'Language: %s' "$(current)")" "$msg" 2>/dev/null
    printf '%s\n' "$msg"
    ;;
apply) niri_env ;;
*) echo "usage: fili-lang [get|list|set CODE|apply]" >&2; exit 2 ;;
esac
