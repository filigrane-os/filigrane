#!/bin/sh
# Generates one .desktop per line of ~/.config/webapps/list (Name | URL | icon) in ~/.local/share/applications.
# The name gets the suffix "(web)" to tell these apps from the native applications.
# Icon: theme name or path; empty = web-browser. The old webapp-*.desktop files absent from the list are deleted.
LIST="${XDG_CONFIG_HOME:-$HOME/.config}/webapps/list"
OUT="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
mkdir -p "$OUT"
keep="$(mktemp)"
if [ -f "$LIST" ]; then
    grep -v '^[[:space:]]*\(#\|$\)' "$LIST" | while IFS='|' read -r name url icon; do
        name="$(echo "$name" | sed 's/^ *//;s/ *$//')"
        url="$(echo "$url" | sed 's/^ *//;s/ *$//')"
        icon="$(echo "$icon" | sed 's/^ *//;s/ *$//')"
        [ -n "$name" ] && [ -n "$url" ] || continue
        case "$icon" in "") icon=web-browser ;; "~/"*) icon="$HOME/${icon#\~/}" ;; esac
        file="webapp-$(echo "$name" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | sed 's/-*$//').desktop"
        cat > "$OUT/$file" <<EOT
[Desktop Entry]
Type=Application
Name=$name (web)
Comment=Application web: $url
Exec=webapp $url
Icon=$icon
Categories=Network;
Keywords=webapp;web;
Terminal=false
EOT
        echo "$file" >> "$keep"
    done
fi
for f in "$OUT"/webapp-*.desktop; do
    [ -e "$f" ] || continue
    grep -qxF "$(basename "$f")" "$keep" || rm -f "$f"
done
rm -f "$keep"
