#!/bin/bash
# What the Filigrane applications declare, for scripts, shortcuts and the assistant (docs/api.md). No AI involved.
#
#   fili-api list              the applications that declare control commands (catalogs shell/ctl/<app_id>.json)
#   fili-api show APP          the commands of one application (APP: app id or name)
#   fili-api apps              the running applications that share a context (pid, name, location)
#   fili-api check FILE        validate a catalog (what an application's `make check` runs)
#   fili-api -h                this help
#
# Catalogs: /usr/share/filigrane/shell/ctl and ~/.local/share/filigrane/shell/ctl (FILI_SHELL_DIRS, colon separated,
# replaces both; the first folder that has an app id wins).
set -euo pipefail
command -v jq >/dev/null || { echo "fili-api: jq is needed" >&2; exit 1; }
dirs() { printf '%s\n' "${FILI_SHELL_DIRS:-/usr/share/filigrane/shell:${XDG_DATA_HOME:-$HOME/.local/share}/filigrane/shell}" | tr ':' '\n'; }
runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}"

# Catalog files, one per app id (the first folder wins)
catalogs() {
    local d f seen=" "
    for d in $(dirs); do
        for f in "$d"/ctl/*.json; do
            [ -f "$f" ] || continue
            local id; id="$(basename "$f" .json)"
            case "$seen" in *" $id "*) continue ;; esac
            seen+="$id "; printf '%s\n' "$f"
        done
    done
}

# Empty when the catalog is valid, else the problems, one per line
problems() {
    jq -r '
      def need(k; t): if has(k) | not then "missing \(k)" elif (.[k] | type) != t then "\(k) must be \(t)" else empty end;
      if type != "object" then "not a JSON object" else
        ( need("v"; "number"), need("app_id"; "string"), need("name"; "string"), need("ctl"; "string"), need("commands"; "array"),
          (if (.v // 1) > 1 then "v \(.v) is newer than this tool understands (1)" else empty end),
          (if (.ctl // "" | type) == "string" and ((.ctl // "") | contains("%pid") | not) and ((.ctl // "") | contains("--pid") ) then "ctl: --pid needs %pid" else empty end),
          ((.commands // [])[]? | select(type != "object" or (.verb // "" | type) != "string" or (.verb // "") == "" or (.summary // "" | type) != "string" or (.summary // "") == "")
             | "a command needs a verb and a summary: \(tostring)") ) end' "$1"
}

case "${1:-}" in
    -h | --help | "") sed -n '2,/^set -e/{/^set -e/!p}' "$0" | sed 's/^# \{0,1\}//' ;;
    list)
        printf '%-16s %-14s %4s  %s\n' APP NAME CMDS CONTROL
        while IFS= read -r f; do
            jq -r '[.app_id, .name, (.commands | length), .ctl] | @tsv' "$f"
        done < <(catalogs) | awk -F'\t' '{ printf "%-16s %-14s %4s  %s\n", $1, $2, $3, $4 }'
        ;;
    show)
        app="${2:?usage: fili-api show APP}"
        found=
        while IFS= read -r f; do
            if jq -e --arg a "$app" '.app_id == $a or (.name | ascii_downcase) == ($a | ascii_downcase)' "$f" >/dev/null; then found="$f"; break; fi
        done < <(catalogs)
        [ -n "$found" ] || { echo "fili-api: no catalog for $app (fili-api list)" >&2; exit 1; }
        jq -r '"\(.name) (\(.app_id)): \(.ctl)\n", (.commands[] | "  \(.verb) \(.args // "")" + (if .reads then "  [read]" else "" end) + "\n      \(.summary)")' "$found"
        ;;
    apps)
        for f in "$runtime"/fili/context/*.json; do
            [ -e "$f" ] || continue
            pid="$(basename "$f" .json)"; [ -d "/proc/$pid" ] || continue
            jq -r --arg p "$pid" '[$p, (.app // "?"), (.location // "")] | @tsv' "$f" 2>/dev/null
        done | awk -F'\t' 'BEGIN { printf "%-8s %-16s %s\n", "PID", "APP", "LOCATION" } { printf "%-8s %-16s %s\n", $1, $2, $3 }'
        ;;
    check)
        f="${2:?usage: fili-api check FILE}"
        [ -f "$f" ] || { echo "fili-api: no such file: $f" >&2; exit 1; }
        jq -e . "$f" >/dev/null 2>&1 || { echo "x $f: not valid JSON"; exit 1; }
        p="$(problems "$f")"
        if [ -n "$p" ]; then printf '%s\n' "$p" | sed 's/^/x /'; exit 1; fi
        echo "ok $f"
        ;;
    *) echo "fili-api: unknown command $1 (fili-api -h)" >&2; exit 2 ;;
esac
