#!/bin/sh
# Uninstalls an application (equivalent of the Omarchy "Uninstall"), to run in a terminal.
# app-uninstall FILE.desktop
# Web app: webapp-remove. Void package: xbps-remove then remove the line in packages/*.txt
# (declarative state of the repository). User .desktop file without a package: deleted.
# Messages in English, translated by lib/i18n/<language>.sh (see lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
f="$1"
[ -f "$f" ] || { echo "usage: app-uninstall FILE.desktop" >&2; exit 1; }
ROOT="$(readlink -f "$0")"; ROOT="${ROOT%/dotfiles/*}"
base="$(basename "$f")"
name="$(sed -n 's/^Name=//p' "$f" | head -1)"
case "$base" in
    webapp-*.desktop)
        webapp-remove "${name% (web)}"; exit $? ;;
esac
owner="$(xbps-query -o "$f" 2>/dev/null | head -1 | sed -E 's/-[^-]+_[0-9]+:.*//')"
if [ -z "$owner" ]; then
    t 'No package owns %s\n' "$f"
    rm -v "$f"; exit $?
fi
t 'Application: %s\n' "$name"
t 'Package:     %s\n' "$owner"
echo
xbps-query -p installed_size "$owner"
printf '\n'; t 'Uninstall %s? [y/N] ' "$owner"
read -r rep
case "$rep" in o|O|y|Y) ;; *) t 'cancelled\n'; exit 0 ;; esac
sudo xbps-remove -R "$owner" || exit $?
# Removes the line of the package (trailing comment included) from the lists of the repository
for l in "$ROOT"/packages/*.txt; do
    grep -qE "^$owner([[:space:]]|\$)" "$l" || continue
    tmp="$(mktemp)"
    grep -vE "^$owner([[:space:]]|\$)" "$l" > "$tmp"
    cat "$tmp" > "$l"; rm -f "$tmp"
    t 'removed from %s\n' "${l#"$ROOT"/}"
done
echo; git -C "$ROOT" diff --stat
