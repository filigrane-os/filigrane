# Generic system settings replayed by bootstrap.sh. Priority: environment variables, then
# users/<user>/config.env (personal layer), then this file.
KEYMAP="${KEYMAP:-us}"
TIMEZONE="${TIMEZONE:-UTC}"
# System language (/etc/locale.conf) and session language until the user chooses another one (fili-lang)
LOCALE="${LOCALE:-C.UTF-8}"
# glibc locales generated in addition to LOCALE: those of the translated languages, so that fili-lang also changes the dates and
# the applications without root (one per catalog of dotfiles/config/quickshell/i18n, plus English)
LOCALES="${LOCALES:-en_US.UTF-8 fr_FR.UTF-8}"
# Keyboard layout of the niri session (xkb), written to ~/.config/niri/keyboard.kdl
XKB_LAYOUT="${XKB_LAYOUT:-us}"
XKB_VARIANT="${XKB_VARIANT:-}"
XKB_OPTIONS="${XKB_OPTIONS:-compose:caps}"
# Groups added to the target user (those that do not exist are ignored)
USER_GROUPS="${USER_GROUPS:-wheel audio video input bluetooth socklog lpadmin}"
# Automatic login on tty1 (then niri through ~/.zprofile): 1 = yes, 0 = no, auto = yes in a VM, no on a physical machine
AUTOLOGIN="${AUTOLOGIN:-auto}"
# AI agent that helps to use, tune and update the machine (fili-ai, Mod+Y, filigrane skill):
# claude (Anthropic), codex (OpenAI), ollama (local models, heavy), opencode (Mistral, Gemini, OpenRouter...),
# none. Change it afterwards: fili-ai use <agent>, choice kept in ~/.config/filigrane/ai.env (the environment and the
# personal layer come first). Old setting CLAUDE_CODE=0 = none.
[ "${CLAUDE_CODE:-1}" = 0 ] && FILI_AI="${FILI_AI:-none}"
FILI_AI="${FILI_AI:-claude}"
# Model (empty = the one of the agent; ollama: gpt-oss:20b, ~16 GB of RAM)
FILI_AI_MODEL="${FILI_AI_MODEL:-}"
# Dossier de travail de l'agent, relatif au dossier personnel
FILI_AI_WORKDIR="${FILI_AI_WORKDIR:-work}"
# Agent options instead of the default ones (permissions, sandbox), e.g. "--permission-mode auto"
FILI_AI_ARGS="${FILI_AI_ARGS:-}"
