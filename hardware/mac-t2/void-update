#!/bin/bash
# System update framed by two snapper snapshots of the root (@void).
# void-update [xbps-install options]     e.g.: void-update -y
# Rollback: see hardware/mac-t2/README.md (Dual boot section).
set -uo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
snap() { snapper --no-dbus -c root "$@"; }

pre="$(snap create -t pre -p -c number -d "void-update")" || { echo "snapper a échoué, mise à jour annulée" >&2; exit 1; }
echo "instantané avant: $pre"
xbps-install -Su "$@"
rc=$?
post="$(snap create -t post --pre-number "$pre" -p -c number -d "void-update (code $rc)")"
echo "instantané après: $post"
snap cleanup number
exit "$rc"
