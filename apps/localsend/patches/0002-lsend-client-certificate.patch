+/// Identité TLS du client (certificat auto-signé), générée une fois par processus. Les téléphones récents exigent un
+/// certificat client (TLS mutuel): sans lui, la connexion échoue avec « certificate required ».
+fn client_identity() -> &'static localsend_protocol::crypto::TlsIdentity {
+    static ID: std::sync::OnceLock<localsend_protocol::crypto::TlsIdentity> = std::sync::OnceLock::new();
+    ID.get_or_init(|| {
+        localsend_protocol::crypto::generate_tls_identity("lsend", &[]).expect("client TLS identity")
+    })
+}
+
+/// Empreinte du certificat client présenté (à annoncer comme empreinte de l'expéditeur).
+pub fn client_fingerprint() -> String {
+    client_identity().fingerprint.clone()
+}
+
+fn client_auth(
+    builder: rustls::ConfigBuilder<ClientConfig, rustls::client::WantsClientCert>,
+) -> Result<ClientConfig, rustls::Error> {
+    let id = client_identity();
+    builder.with_client_auth_cert(
+        vec![CertificateDer::from(id.cert_der.clone())],
+        rustls::pki_types::PrivateKeyDer::Pkcs8(rustls::pki_types::PrivatePkcs8KeyDer::from(
+            id.key_der_pkcs8.clone(),
+        )),
+    )
+}
+
+/// Vérificateur qui accepte tout certificat serveur (sondage de l'empreinte seulement).
+#[derive(Debug)]
+struct AcceptAny(WebPkiSupportedAlgorithms);
+
+impl ServerCertVerifier for AcceptAny {
+    fn verify_server_cert(
+        &self,
+        _end_entity: &CertificateDer<'_>,
+        _intermediates: &[CertificateDer<'_>],
+        _server_name: &ServerName<'_>,
+        _ocsp_response: &[u8],
+        _now: UnixTime,
+    ) -> Result<ServerCertVerified, rustls::Error> {
+        Ok(ServerCertVerified::assertion())
+    }
+    fn verify_tls12_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        rustls::crypto::verify_tls12_signature(message, cert, dss, &self.0)
+    }
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        rustls::crypto::verify_tls13_signature(message, cert, dss, &self.0)
+    }
+    fn supported_verify_schemes(&self) -> Vec<SignatureScheme> {
+        self.0.supported_schemes()
+    }
+}
+
