# xbps package of fili-recorder (Cassette), read by distro/build-repo.sh. Qt Quick comes with Quickshell already; qt6-svg draws its
# icon, qt6-wayland is the platform plugin. The sound goes through PipeWire (pw-record and pw-cat), the devices are listed by pactl,
# GStreamer (opus encoder and decoder, ogg) and lame (MP3) compress and decode the recordings, glib gives `gio trash`, wl-clipboard the clipboard, libnotify (notify-send) the "recording saved" notification.
DESC="Cassette, the sound recorder and player of Filigrane (Qt Quick, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0 qt6-wayland>=0 pipewire>=0 pulseaudio-utils>=0 glib>=0 wl-clipboard>=0 libnotify>=0 xdg-utils>=0 gstreamer1>=0 gst-plugins-base1>=0 lame>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6"
PKG_LICENSE="GPL-3.0-or-later"
# Same program under another name: `cassette` in a terminal does what `fili-recorder` does
ALIASES="cassette"
