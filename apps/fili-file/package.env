# Paquet xbps de fili-file (lu par distro/build-repo.sh). Qt Quick est déjà là pour Quickshell; qt6-svg pour les icônes.
DESC="Casier, l'explorateur de fichiers de Filigrane (Qt Quick, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6"
# Same program under its display name: `casier` in a terminal does what `fili-file` does
ALIASES="casier"
