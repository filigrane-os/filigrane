# xbps package of fili-file (read by distro/build-repo.sh). Qt Quick comes with Quickshell already; qt6-svg draws the
# icons, qt6-wayland is the platform plugin, wl-clipboard the clipboard, glib the `gio` command (trash, mounts),
# shared-mime-info the file types, adwaita-icon-theme the fallback icons (any other icon theme works too).
DESC="Casier, the file manager of Filigrane (Qt Quick, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0 qt6-wayland>=0 wl-clipboard>=0 glib>=0 shared-mime-info>=0 adwaita-icon-theme>=0 util-linux>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6"
PKG_LICENSE="GPL-3.0-or-later"
# Same program under its display name: `casier` in a terminal does what `fili-file` does
ALIASES="casier"
