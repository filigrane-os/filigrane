# xbps package of fili-music (Baladeur), read by distro/build-repo.sh. Qt Quick comes with Quickshell already; qt6-svg draws its
# icon, qt6-wayland is the platform plugin. The sound is played by tornade-core through ALSA (cpal), which PipeWire answers
# with alsa-pipewire; the tags and the library are read by the core itself (SQLite and lofty are compiled in).
DESC="Baladeur, the music player of Filigrane (Qt Quick, Rust, tornade-core)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0 qt6-wayland>=0 alsa-lib>=0 alsa-pipewire>=0 xdg-utils>=0 wl-clipboard>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6 libasound.so.2"
PKG_LICENSE="GPL-3.0-or-later"
# Same program under another name: `baladeur` in a terminal does what `fili-music` does
ALIASES="baladeur"
