# xbps package of fili-incident, read by distro/build-repo.sh. curl asks GitHub whether the problem is already reported,
# libnotify shows the notification (with its buttons), xdg-utils opens the prefilled issue form, wl-clipboard copies the
# report. gh is optional: with it (and an account) the issue is created or +1'd from here, without it the form opens in the browser.
DESC="Problems of the fili-* applications: notification, Lia and the GitHub issue"
DEPENDS="glibc>=2.39_1 libgcc>=0 curl>=0 libnotify>=0 xdg-utils>=0 wl-clipboard>=0"
SHLIBS="libc.so.6 libgcc_s.so.1"
PKG_LICENSE="GPL-3.0-or-later"
