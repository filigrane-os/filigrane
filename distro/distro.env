# Identity of the distribution: Filigrane, the watermark OS that leaves room for the applications.
# DISTRO is the short name (commands, fili-* packages, ISO, fili-install installer, default machine name).
DISTRO="${DISTRO:-fili}"
DISTRO_TITLE="${DISTRO_TITLE:-Filigrane (Void Linux + niri)}"
DISTRO_HOMEPAGE="${DISTRO_HOMEPAGE:-https://github.com/filigrane-os/filigrane}"
# Git repository cloned by the installer (updates: git pull then ./bootstrap.sh)
DISTRO_GIT="${DISTRO_GIT:-https://github.com/filigrane-os/filigrane}"
# Upstream Void repositories (the distribution repository only holds its own packages)
VOID_REPO="${VOID_REPO:-https://repo-default.voidlinux.org/current}"
# pinned void-mklive (official tool to build Void ISOs)
MKLIVE_GIT="${MKLIVE_GIT:-https://github.com/void-linux/void-mklive}"
MKLIVE_REF="${MKLIVE_REF:-master}"
# Published xbps repository (assets of the GitHub release "repo", see .github/workflows/repo.yml).
# The only address to change the day the repository moves to a domain name (the fili-repo package distributes it to the machines).
DISTRO_REPO_URL="${DISTRO_REPO_URL:-https://github.com/filigrane-os/filigrane/releases/download/repo}"
