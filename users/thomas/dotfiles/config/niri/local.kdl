// Personal niri settings (users/thomas layer), included at the end of ~/.config/niri/config.kdl

// Proton Mail: local IMAP bridge without GUI, then listening for new mail (restarted if the bridge is not ready)
spawn-at-startup "protonmail-bridge" "--noninteractive"
spawn-sh-at-startup "while :; do goimapnotify; sleep 30; done"
// WhatsApp without a browser: whatsapp-unreadd + unread counter (pairing: wa-pair), see ~/.local/bin/wa-daemon
spawn-at-startup "wa-daemon"
// "WhatsApp call" window floating (title known after it opens), see ~/.local/bin/wa-call-float
spawn-sh-at-startup "$HOME/.local/bin/wa-call-float"
// Proton Calendar notifications (ICS link in ~/.config/proton-calendar.url), see ~/.local/bin/cal-notify
spawn-sh-at-startup "$HOME/.local/bin/cal-notify"
// iCloud Drive in ~/iCloud (rclone mount, files downloaded on open), see ~/.local/bin/icloud-mount
spawn-sh-at-startup "$HOME/.local/bin/icloud-mount"

binds {
    Mod+Shift+C hotkey-overlay-title="iCloud Drive (Files)" { spawn-sh "/usr/bin/fili-file \"$HOME/iCloud\""; }
}
